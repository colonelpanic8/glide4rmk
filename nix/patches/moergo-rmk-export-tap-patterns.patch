diff --git a/crates/moergo-config/src/moergo/raise.rs b/crates/moergo-config/src/moergo/raise.rs
new file mode 100644
index 0000000..133f8cf
--- /dev/null
+++ b/crates/moergo-config/src/moergo/raise.rs
@@ -0,0 +1,1233 @@
+//! Raising of Rynk runtime behaviors back into MoErgo editor definitions.
+//!
+//! This is the inverse of [`super::lower`]. A keymap cell that holds a morse
+//! (`TD(n)`), a profiled tap-hold or a macro trigger has no single editor
+//! binding; it needs a named behavior in one of the document's tables and a
+//! key that names it. Each definition written here is the shape the import
+//! lowers back to the same runtime value, so an import, export and import
+//! again yields the same snapshot.
+//!
+//! Definitions are interned by their content: keys that share a behavior share
+//! one definition, and a definition the template document already carries is
+//! reused by name rather than added a second time.
+
+use std::collections::BTreeSet;
+
+use rynk::rmk_types::action::{Action, KeyAction, KeyboardAction, LightAction};
+use rynk::rmk_types::combo::ComboDefinition;
+use rynk::rmk_types::fork::{Fork, StateBits};
+use rynk::rmk_types::keyboard_macros::MacroOp;
+use rynk::rmk_types::keycode::{HidKeyCode, KeyCode};
+use rynk::rmk_types::modifier::{ModifierCombination, ModifierKey};
+use rynk::rmk_types::morse::{Morse, MorseMode, MorsePattern, MorseProfile, HOLD, TAP};
+use serde_json::{json, Map, Value};
+
+use crate::{BehaviorSnapshot, MorseProfileEntry, RuntimeConfig, COLS};
+
+/// Glove80 editor positions of the thumb keys, by hand.
+const LEFT_THUMBS: [usize; 6] = [52, 53, 54, 69, 70, 71];
+const RIGHT_THUMBS: [usize; 6] = [55, 56, 57, 72, 73, 74];
+
+/// The tapping term ZMK uses when a behavior names none, written when the
+/// runtime profile leaves the hold timeout to the firmware default and the
+/// snapshot does not say what that default is.
+const ZMK_TAPPING_TERM_MS: u16 = 200;
+
+/// The behavior tables a MoErgo document keeps definitions in.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Table {
+    HoldTaps,
+    TapDances,
+    Macros,
+    StickyKeys,
+    ModMorphs,
+}
+
+impl Table {
+    pub const ALL: [Table; 5] = [
+        Table::HoldTaps,
+        Table::TapDances,
+        Table::Macros,
+        Table::StickyKeys,
+        Table::ModMorphs,
+    ];
+
+    pub fn key(self) -> &'static str {
+        match self {
+            Table::HoldTaps => "holdTaps",
+            Table::TapDances => "tapDances",
+            Table::Macros => "macros",
+            Table::StickyKeys => "stickyKeys",
+            Table::ModMorphs => "modMorphs",
+        }
+    }
+}
+
+/// Which half of the keyboard an editor key is on.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Hand {
+    Left,
+    Right,
+}
+
+impl Hand {
+    fn of(editor_index: usize) -> Self {
+        let offset = super::MOERGO_TO_MATRIX[editor_index];
+        if offset % usize::from(COLS) < 7 {
+            Hand::Left
+        } else {
+            Hand::Right
+        }
+    }
+
+    fn suffix(self) -> &'static str {
+        match self {
+            Hand::Left => "left",
+            Hand::Right => "right",
+        }
+    }
+
+    /// ZMK's `hold-trigger-key-positions` for a bilateral hold on this hand:
+    /// every key of the other hand, plus this hand's own thumbs, which is the
+    /// set TailorKey-style layouts write and what Rynk's unilateral tap means.
+    fn trigger_positions(self) -> Vec<usize> {
+        let own_thumbs = match self {
+            Hand::Left => LEFT_THUMBS,
+            Hand::Right => RIGHT_THUMBS,
+        };
+        (0..super::MOERGO_TO_MATRIX.len())
+            .filter(|&index| Hand::of(index) != self || own_thumbs.contains(&index))
+            .collect()
+    }
+}
+
+/// Where a cell is, for the messages that name it.
+pub(crate) struct Cell<'a> {
+    pub layer: usize,
+    pub layer_name: &'a str,
+    pub editor_index: usize,
+    pub offset: usize,
+}
+
+impl Cell<'_> {
+    pub fn describe(&self) -> String {
+        format!(
+            "layer {} ({}), editor key {} (r{},c{})",
+            self.layer,
+            self.layer_name,
+            self.editor_index,
+            self.offset / usize::from(COLS),
+            self.offset % usize::from(COLS)
+        )
+    }
+}
+
+/// A key that cannot be written, with the reason in the user's terms.
+type Refusal = String;
+
+pub(crate) struct Raising<'a> {
+    behaviors: &'a BehaviorSnapshot,
+    labels: Option<&'a RuntimeConfig>,
+    default_profile: MorseProfile,
+    /// Definitions already in the document, by table, so equal content is
+    /// reused rather than repeated.
+    existing: Vec<(Table, Value)>,
+    /// Every behavior name in use, so a new definition never shadows one.
+    taken: BTreeSet<String>,
+    /// Definitions this export adds, in the order they were first needed.
+    added: Vec<(Table, Value)>,
+    /// The snapshot's forks, and whether a key carried each one.
+    forks: Vec<(Fork, bool)>,
+    /// The combo timeout the template's combos agree on, kept when the
+    /// snapshot does not say (an imported layout has no global setting).
+    template_combo_timeout: Option<u64>,
+    /// The template's combos, so one that says the same thing keeps its name
+    /// and description.
+    template_combos: Vec<Value>,
+}
+
+impl<'a> Raising<'a> {
+    pub fn new(
+        behaviors: &'a BehaviorSnapshot,
+        labels: Option<&'a RuntimeConfig>,
+        layout: &Map<String, Value>,
+    ) -> Self {
+        let mut existing = Vec::new();
+        let mut taken = BTreeSet::new();
+        for table in Table::ALL {
+            for entry in layout
+                .get(table.key())
+                .and_then(Value::as_array)
+                .into_iter()
+                .flatten()
+            {
+                if let Some(name) = entry.get("name").and_then(Value::as_str) {
+                    taken.insert(name.to_owned());
+                }
+                existing.push((table, entry.clone()));
+            }
+        }
+        let default_profile = behaviors
+            .config
+            .as_ref()
+            .map_or_else(MorseProfile::const_default, |config| {
+                config.morse_default_profile
+            });
+        let forks = behaviors
+            .forks
+            .as_deref()
+            .unwrap_or_default()
+            .iter()
+            .map(|fork| (*fork, false))
+            .collect();
+        let mut timeouts: Vec<u64> = layout
+            .get("combos")
+            .and_then(Value::as_array)
+            .into_iter()
+            .flatten()
+            .filter_map(|combo| combo.get("timeoutMs").and_then(Value::as_u64))
+            .collect();
+        timeouts.sort_unstable();
+        timeouts.dedup();
+        Self {
+            behaviors,
+            labels,
+            default_profile,
+            existing,
+            taken,
+            added: Vec::new(),
+            forks,
+            template_combo_timeout: (timeouts.len() == 1).then(|| timeouts[0]),
+            template_combos: layout
+                .get("combos")
+                .and_then(Value::as_array)
+                .cloned()
+                .unwrap_or_default(),
+        }
+    }
+
+    /// The editor binding for one keymap cell, or the reason it has none.
+    ///
+    /// A cell whose action a fork rewrites becomes a mod-morph: MoErgo binds
+    /// the modifier swap to the key, where Rynk matches it on the action.
+    pub fn cell_binding(&mut self, action: KeyAction, cell: &Cell) -> Result<Value, Refusal> {
+        let Some(index) = self
+            .forks
+            .iter()
+            .position(|(fork, _)| fork.trigger == action)
+        else {
+            return self.unforked_binding(action, cell);
+        };
+        self.forks[index].1 = true;
+        let fork = self.forks[index].0;
+        let named = || format!("{} (a fork)", action_label(action));
+        let mods = fork_condition(&fork).map_err(|why| format!("{}: {why}", named()))?;
+        let default = self.unforked_binding(action, cell)?;
+        let positive = self.unforked_binding(fork.positive_output, cell)?;
+        for binding in [&default, &positive] {
+            let value = binding
+                .get("value")
+                .and_then(Value::as_str)
+                .unwrap_or_default();
+            if value != "&kp" && !self.defines(value) {
+                return Err(format!(
+                    "{}: a MoErgo mod-morph is read back only when both outputs are keys or \
+                     behaviors of this file, and one is {value}",
+                    named()
+                ));
+            }
+        }
+        let keep = modifier_names(fork.kept_modifiers);
+        let mut definition = Map::new();
+        definition.insert(
+            "cases".into(),
+            json!([
+                { "binding": default, "mods": [], "keepMods": [] },
+                { "binding": positive, "mods": mods, "keepMods": keep }
+            ]),
+        );
+        let label = self
+            .labels
+            .and_then(|labels| labels.forks.get(index))
+            .map(|fork| fork.name.clone())
+            .filter(|name| !name.is_empty())
+            .unwrap_or_else(|| "mod_morph".to_owned());
+        let name = self.intern(Table::ModMorphs, &label, definition);
+        Ok(json!({ "value": name }))
+    }
+
+    fn unforked_binding(&mut self, action: KeyAction, cell: &Cell) -> Result<Value, Refusal> {
+        if action == KeyAction::Single(Action::User(12))
+            && Hand::of(cell.editor_index) == Hand::Left
+        {
+            return Err(left_half_bootloader());
+        }
+        if let Some(binding) = self.binding(action, cell)? {
+            return Ok(binding);
+        }
+        plain_binding(action, cell)
+    }
+
+    /// Forks no key carried. MoErgo's mod-morph lives on a key, so these
+    /// cannot be written.
+    pub fn unused_forks(&self) -> Vec<Refusal> {
+        self.forks
+            .iter()
+            .filter(|(_, used)| !used)
+            .map(|(fork, _)| {
+                format!(
+                    "the fork on {} matches no key; a MoErgo mod-morph exists only on a key",
+                    action_label(fork.trigger)
+                )
+            })
+            .collect()
+    }
+
+    fn defines(&self, name: &str) -> bool {
+        self.existing
+            .iter()
+            .chain(&self.added)
+            .any(|(_, entry)| entry.get("name").and_then(Value::as_str) == Some(name))
+    }
+
+    /// The snapshot's combos as editor combos, or `None` when the snapshot
+    /// does not manage combos and the template's should stand.
+    pub fn combos(&mut self) -> Option<Result<Vec<Value>, Vec<Refusal>>> {
+        let combos = self.behaviors.combos.clone()?;
+        let mut out = Vec::new();
+        let mut refusals = Vec::new();
+        let mut names = BTreeSet::new();
+        let timeout = self
+            .behaviors
+            .config
+            .as_ref()
+            .map(|config| u64::from(config.combo_timeout_ms))
+            .or(self.template_combo_timeout);
+        for (index, definition) in combos.iter().enumerate() {
+            let label = self
+                .labels
+                .and_then(|labels| labels.combos.get(index))
+                .map(|combo| combo.name.clone())
+                .filter(|name| !name.is_empty())
+                .unwrap_or_else(|| format!("combo {index}"));
+            let ComboDefinition::Positions(combo) = definition else {
+                refusals.push(format!(
+                    "combo '{label}' matches on key actions; MoErgo combos match key positions"
+                ));
+                continue;
+            };
+            let positions: Option<Vec<usize>> = combo
+                .positions
+                .iter()
+                .map(|position| {
+                    let offset =
+                        usize::from(position.row) * usize::from(COLS) + usize::from(position.col);
+                    super::MOERGO_TO_MATRIX
+                        .iter()
+                        .position(|&cell| cell == offset)
+                })
+                .collect();
+            let Some(positions) = positions.filter(|positions| !positions.is_empty()) else {
+                refusals.push(format!(
+                    "combo '{label}' uses a matrix position the Glove80 has no key at"
+                ));
+                continue;
+            };
+            let cell = Cell {
+                layer: combo.layer.map_or(0, usize::from),
+                layer_name: "combo",
+                editor_index: positions[0],
+                offset: super::MOERGO_TO_MATRIX[positions[0]],
+            };
+            let binding = match combo.output {
+                KeyAction::LayerModTap(layer, modifier, key) => {
+                    self.window_switcher(layer, modifier, key)
+                }
+                output => self.cell_binding(output, &cell),
+            };
+            let binding = match binding {
+                Ok(binding) => binding,
+                Err(why) => {
+                    refusals.push(format!("combo '{label}': {why}"));
+                    continue;
+                }
+            };
+            let layers = json!([combo.layer.map_or(-1, i64::from)]);
+            let same = self.template_combos.iter().find(|entry| {
+                entry.get("binding") == Some(&binding)
+                    && entry.get("keyPositions") == Some(&json!(positions))
+                    && entry.get("layers") == Some(&layers)
+                    && entry
+                        .get("name")
+                        .and_then(Value::as_str)
+                        .is_some_and(|name| !names.contains(name))
+            });
+            let description = same
+                .and_then(|entry| entry.get("description"))
+                .cloned()
+                .unwrap_or_else(|| json!(""));
+            let mut name = same
+                .and_then(|entry| entry.get("name"))
+                .and_then(Value::as_str)
+                .map_or_else(|| combo_name(&label, index), str::to_owned);
+            let stem = name.clone();
+            let mut suffix = 2;
+            while !names.insert(name.clone()) {
+                name = format!("{stem}_{suffix}");
+                suffix += 1;
+            }
+            let mut entry = Map::new();
+            entry.insert("name".into(), json!(name));
+            entry.insert("description".into(), description);
+            entry.insert("binding".into(), binding);
+            entry.insert("keyPositions".into(), json!(positions));
+            entry.insert("layers".into(), layers);
+            if let Some(timeout) = timeout {
+                entry.insert("timeoutMs".into(), json!(timeout));
+            }
+            out.push(Value::Object(entry));
+        }
+        Some(if refusals.is_empty() {
+            Ok(out)
+        } else {
+            Err(refusals)
+        })
+    }
+
+    /// `LMT(layer, mod, key)`: hold a modifier and a layer while tapping a key
+    /// once, written as the parameterized macro the import reads back as one
+    /// (`holds_modifier_with_layer`, `chord_tap_key`). Only a combo output
+    /// is read back this way.
+    fn window_switcher(
+        &mut self,
+        layer: u8,
+        modifier: ModifierKey,
+        key: HidKeyCode,
+    ) -> Result<Value, Refusal> {
+        let tap = super::via_basic_to_zmk(key as u16).map_err(|error| error.to_string())?;
+        let placeholder = || json!({ "value": "MACRO_PLACEHOLDER", "params": [] });
+        let mut definition = Map::new();
+        definition.insert("params".into(), json!(["code", "layer"]));
+        definition.insert("waitMs".into(), json!(0));
+        definition.insert("tapMs".into(), json!(0));
+        definition.insert(
+            "bindings".into(),
+            json!([
+                { "value": "&macro_press" },
+                { "value": "&macro_param_1to1" },
+                { "value": "&kp", "params": [placeholder()] },
+                { "value": "&macro_param_2to1" },
+                { "value": "&mo", "params": [placeholder()] },
+                { "value": "&macro_tap" },
+                { "value": "&kp", "params": [{ "value": tap, "params": [] }] },
+                { "value": "&macro_pause_for_release" },
+                { "value": "&macro_release" },
+                { "value": "&macro_param_1to1" },
+                { "value": "&kp", "params": [placeholder()] },
+                { "value": "&macro_param_2to1" },
+                { "value": "&mo", "params": [placeholder()] }
+            ]),
+        );
+        let name = self.intern(Table::Macros, &format!("window_switch_{tap}"), definition);
+        Ok(json!({
+            "value": name,
+            "params": [
+                { "value": modifier_key_name(modifier), "params": [] },
+                { "value": layer, "params": [] }
+            ]
+        }))
+    }
+
+    /// The definitions this export adds to each table.
+    pub fn added(&self) -> &[(Table, Value)] {
+        &self.added
+    }
+
+    /// The editor binding for a cell that names a behavior definition, or
+    /// `Ok(None)` when the plain keycode path already represents it exactly.
+    pub fn binding(&mut self, action: KeyAction, cell: &Cell) -> Result<Option<Value>, Refusal> {
+        match action {
+            KeyAction::Morse(index) => self.morse(index, cell).map(Some),
+            KeyAction::TapHold(tap, hold, profile) => {
+                let named = self.profile_entry(profile).cloned();
+                match named {
+                    Some(entry) => self
+                        .tap_hold(tap, hold, entry.profile, Some(&entry.name), cell)
+                        .map(Some),
+                    // Without a named profile, `&mt`/`&lt` say it exactly; only
+                    // the shapes they cannot carry need a definition.
+                    None if is_autoshift(tap, hold) => self
+                        .tap_hold(tap, hold, MorseProfile::const_default(), None, cell)
+                        .map(Some),
+                    None => Ok(None),
+                }
+            }
+            KeyAction::Single(Action::TriggerMacro(index)) => self.trigger_macro(index).map(Some),
+            KeyAction::Single(action) => refusal_for(action).map_or(Ok(None), Err),
+            _ => Ok(None),
+        }
+    }
+
+    fn profile_entry(&self, index: u8) -> Option<&MorseProfileEntry> {
+        self.behaviors
+            .morse_profiles
+            .as_deref()
+            .unwrap_or_default()
+            .iter()
+            .find(|entry| entry.index == index)
+    }
+
+    fn morse_label(&self, index: u8) -> Option<&str> {
+        let name = self.labels?.morses.get(usize::from(index))?.name.as_str();
+        // The import names its morses `morse N`; that says nothing worth
+        // keeping as a behavior name.
+        (!name.is_empty() && !name.starts_with("morse ")).then_some(name)
+    }
+
+    fn morse(&mut self, index: u8, cell: &Cell) -> Result<Value, Refusal> {
+        let morse = self
+            .behaviors
+            .morses
+            .as_deref()
+            .unwrap_or_default()
+            .get(usize::from(index))
+            .cloned()
+            .ok_or_else(|| format!("TD({index}) names a tap pattern the layout does not define"))?;
+        let label = self.morse_label(index).map(str::to_owned);
+        let patterns: Vec<MorsePattern> =
+            morse.actions.iter().map(|(pattern, _)| *pattern).collect();
+
+        if patterns.len() == 2 && patterns.contains(&TAP) && patterns.contains(&HOLD) {
+            let tap = morse.get(TAP).unwrap_or(Action::No);
+            let hold = morse.get(HOLD).unwrap_or(Action::No);
+            return self.tap_hold(tap, hold, morse.profile, label.as_deref(), cell);
+        }
+        if let Some(taps) = tap_sequence(&morse) {
+            if taps.len() == 1 {
+                // One tap and nothing else is the key itself.
+                return plain_binding(KeyAction::Single(taps[0]), cell)
+                    .map_err(|why| format!("TD({index}) taps {why}"));
+            }
+            return self.tap_dance(index, &taps, morse.profile, label.as_deref(), cell);
+        }
+        Err(format!(
+            "TD({index}) is a tap pattern ({}) that MoErgo can only express as a hold-tap \
+             (one tap, one hold) or a tap-dance (taps only, at most five)",
+            describe_patterns(&morse)
+        ))
+    }
+
+    /// A tap and a hold, written as the hold-tap whose lowering yields them.
+    fn tap_hold(
+        &mut self,
+        tap: Action,
+        hold: Action,
+        profile: MorseProfile,
+        label: Option<&str>,
+        cell: &Cell,
+    ) -> Result<Value, Refusal> {
+        let what = || format!("tap {} / hold {}", action_text(tap), action_text(hold));
+        let unilateral = profile.unilateral_tap() == Some(true);
+        let hand = Hand::of(cell.editor_index);
+
+        let (shape, bindings, params): (&str, [String; 2], [Value; 2]) = match (tap, hold) {
+            (Action::Key(KeyCode::Hid(key)), Action::Modifier(modifiers)) => {
+                let modifier = single_modifier(modifiers).ok_or_else(|| {
+                    format!(
+                        "{} holds several modifiers at once; a MoErgo hold-tap holds one",
+                        what()
+                    )
+                })?;
+                (
+                    if unilateral { "hrm" } else { "mod_tap" },
+                    ["&kp".into(), "&kp".into()],
+                    [json!(modifier), json!(basic_name(key, &what)?)],
+                )
+            }
+            (Action::Key(KeyCode::Hid(key)), Action::LayerOn(layer)) => (
+                "layer_tap",
+                ["&mo".into(), "&kp".into()],
+                [json!(layer), json!(basic_name(key, &what)?)],
+            ),
+            (Action::Key(KeyCode::Hid(key)), Action::KeyWithModifier(..))
+                if is_autoshift(tap, hold) =>
+            {
+                let wrapper = self.shift_wrapper();
+                let key = basic_name(key, &what)?;
+                (
+                    "autoshift",
+                    [wrapper, "&kp".into()],
+                    [json!(key), json!(key)],
+                )
+            }
+            (Action::OneShotModifier(armed), held) => {
+                let armed = single_modifier(armed).ok_or_else(|| {
+                    format!(
+                        "{} arms several modifiers; MoErgo's sticky key arms one",
+                        what()
+                    )
+                })?;
+                let held = match held {
+                    Action::Key(KeyCode::Hid(key)) if is_modifier_key(key) => {
+                        basic_name(key, &what)?.to_owned()
+                    }
+                    Action::Modifier(modifiers) => single_modifier(modifiers)
+                        .ok_or_else(|| format!("{} holds several modifiers at once", what()))?,
+                    _ => {
+                        return Err(format!(
+                            "{}: a sticky modifier can only be held as a modifier",
+                            what()
+                        ))
+                    }
+                };
+                let sticky = self.sticky_key();
+                (
+                    "sticky_mod_tap",
+                    ["&kp".into(), sticky],
+                    [json!(held), json!(armed)],
+                )
+            }
+            _ => {
+                return Err(format!(
+                    "{} has no MoErgo hold-tap form: the import reads a hold-tap only as \
+                     modifier/key, layer/key, autoshift or sticky modifier",
+                    what()
+                ))
+            }
+        };
+        if unilateral && !matches!(shape, "hrm" | "layer_tap") {
+            return Err(format!(
+                "{} decides its hold by hand, which MoErgo expresses only for a modifier or \
+                 layer hold",
+                what()
+            ));
+        }
+
+        let mut definition = Map::new();
+        definition.insert("bindings".into(), json!(bindings));
+        definition.extend(self.timing(profile));
+        if unilateral {
+            definition.insert(
+                "holdTriggerKeyPositions".into(),
+                json!(hand.trigger_positions()),
+            );
+        }
+        let base = match (label, unilateral) {
+            (Some(label), true) => format!("{label}_{}", hand.suffix()),
+            (Some(label), false) => label.to_owned(),
+            (None, true) => format!("{shape}_{}", hand.suffix()),
+            (None, false) => shape.to_owned(),
+        };
+        let name = self.intern(Table::HoldTaps, &base, definition);
+        Ok(json!({
+            "value": name,
+            "params": params.iter().map(|value| json!({ "value": value, "params": [] })).collect::<Vec<_>>(),
+        }))
+    }
+
+    /// The hold-tap timing fields of a runtime profile. Fields the profile
+    /// leaves to the firmware are filled from the snapshot's default profile,
+    /// because ZMK requires a tapping term on every hold-tap.
+    fn timing(&self, profile: MorseProfile) -> Map<String, Value> {
+        let mut fields = Map::new();
+        let term = profile
+            .hold_timeout_ms()
+            .or(self.default_profile.hold_timeout_ms())
+            .unwrap_or(ZMK_TAPPING_TERM_MS);
+        fields.insert("tappingTermMs".into(), json!(term));
+        if let Some(flavor) = profile.mode().map(flavor_of) {
+            fields.insert("flavor".into(), json!(flavor));
+        }
+        if let Some(ms) = profile.quick_tap_timeout_ms() {
+            fields.insert("quickTapMs".into(), json!(ms));
+        }
+        if let Some(ms) = profile.prior_idle_time_ms() {
+            fields.insert("requirePriorIdleMs".into(), json!(ms));
+        }
+        if profile.hold_trigger_on_release() == Some(true) {
+            fields.insert("holdTriggerOnRelease".into(), json!(true));
+        }
+        fields
+    }
+
+    fn tap_dance(
+        &mut self,
+        index: u8,
+        taps: &[Action],
+        profile: MorseProfile,
+        label: Option<&str>,
+        cell: &Cell,
+    ) -> Result<Value, Refusal> {
+        let mut bindings = Vec::with_capacity(taps.len());
+        for (count, action) in taps.iter().enumerate() {
+            let binding = match action {
+                Action::Key(KeyCode::Hid(_)) | Action::KeyWithModifier(..) => {
+                    plain_binding(KeyAction::Single(*action), cell)
+                }
+                _ => Err(action_text(*action)),
+            }
+            .map_err(|_| {
+                format!(
+                    "TD({index}) sends {} on {} tap{}; a MoErgo tap-dance is read back only \
+                     when every step is a key",
+                    action_text(*action),
+                    count + 1,
+                    if count == 0 { "" } else { "s" }
+                )
+            })?;
+            bindings.push(binding);
+        }
+        let term = profile
+            .gap_timeout_ms()
+            .or(self.default_profile.gap_timeout_ms())
+            .unwrap_or(ZMK_TAPPING_TERM_MS);
+        let mut definition = Map::new();
+        definition.insert("tappingTermMs".into(), json!(term));
+        definition.insert("bindings".into(), Value::Array(bindings));
+        let name = self.intern(Table::TapDances, label.unwrap_or("tap_dance"), definition);
+        Ok(json!({ "value": name }))
+    }
+
+    fn trigger_macro(&mut self, index: u8) -> Result<Value, Refusal> {
+        let ops = self
+            .behaviors
+            .macros
+            .as_deref()
+            .unwrap_or_default()
+            .get(usize::from(index))
+            .cloned()
+            .ok_or_else(|| format!("MACRO({index}) names a macro the layout does not define"))?;
+        let mut bindings = Vec::new();
+        let mut mode: Option<&str> = None;
+        for op in &ops {
+            let (step, action) = match op {
+                MacroOp::Tap(action) => ("&macro_tap", action),
+                MacroOp::Press(action) => ("&macro_press", action),
+                MacroOp::Release(action) => ("&macro_release", action),
+                other => {
+                    return Err(format!(
+                        "MACRO({index}) has a {} step; the import reads back only key taps, \
+                         presses and releases",
+                        macro_op_text(other)
+                    ))
+                }
+            };
+            let code = match action {
+                Action::Key(KeyCode::Hid(key)) => *key as u16,
+                Action::KeyWithModifier(key, modifiers) => {
+                    (u16::from(modifiers.into_packed_bits()) << 8) | *key as u16
+                }
+                other => {
+                    return Err(format!(
+                        "MACRO({index}) steps through {}; the import reads back only keys",
+                        action_text(*other)
+                    ))
+                }
+            };
+            let key = if code > 0xff {
+                super::modified_to_zmk(code)
+            } else {
+                super::via_basic_to_zmk(code).map(str::to_owned)
+            }
+            .map_err(|error| format!("MACRO({index}) {error}"))?;
+            if mode != Some(step) {
+                bindings.push(json!({ "value": step }));
+                mode = Some(step);
+            }
+            bindings.push(json!({ "value": "&kp", "params": [{ "value": key, "params": [] }] }));
+        }
+        if bindings.is_empty() {
+            return Err(format!("MACRO({index}) is empty"));
+        }
+        let label = self
+            .labels
+            .and_then(|labels| labels.macros.get(usize::from(index)))
+            .map(|entry| entry.name.clone())
+            .filter(|name| !name.is_empty())
+            .unwrap_or_else(|| format!("macro_{index}"));
+        let mut definition = Map::new();
+        definition.insert("waitMs".into(), json!(0));
+        definition.insert("tapMs".into(), json!(0));
+        definition.insert("bindings".into(), Value::Array(bindings));
+        let name = self.intern(Table::Macros, &label, definition);
+        Ok(json!({ "value": name }))
+    }
+
+    /// The macro an autoshift hold-tap holds: shift around its parameter. The
+    /// import recognizes exactly this shape (`is_shift_wrapper`).
+    fn shift_wrapper(&mut self) -> String {
+        let mut definition = Map::new();
+        definition.insert("params".into(), json!(["code"]));
+        definition.insert("waitMs".into(), json!(0));
+        definition.insert("tapMs".into(), json!(0));
+        definition.insert(
+            "bindings".into(),
+            json!([
+                { "value": "&macro_press" },
+                { "value": "&kp", "params": [{ "value": "LSHFT", "params": [] }] },
+                { "value": "&macro_tap" },
+                { "value": "&macro_param_1to1" },
+                { "value": "&kp", "params": [{ "value": "MACRO_PLACEHOLDER", "params": [] }] },
+                { "value": "&macro_release" },
+                { "value": "&kp", "params": [{ "value": "LSHFT", "params": [] }] }
+            ]),
+        );
+        self.intern(Table::Macros, "autoshift_shift", definition)
+    }
+
+    /// The sticky key a sticky-modifier hold-tap taps. The import recognizes
+    /// it by the `&sticky_key` prefix of its name.
+    fn sticky_key(&mut self) -> String {
+        let mut definition = Map::new();
+        definition.insert("bindings".into(), json!(["&kp"]));
+        self.intern(Table::StickyKeys, "sticky_key_oneshot", definition)
+    }
+
+    /// Returns the name of a definition with this content, adding it under a
+    /// fresh name derived from `base` when neither the template nor this export
+    /// has one yet.
+    fn intern(&mut self, table: Table, base: &str, definition: Map<String, Value>) -> String {
+        let content = Value::Object(definition.clone());
+        let same = |entry: &Value| {
+            let mut entry = entry.clone();
+            if let Some(object) = entry.as_object_mut() {
+                for key in ["name", "description", "descriptorId"] {
+                    object.remove(key);
+                }
+            }
+            entry == content
+        };
+        for (existing_table, entry) in self.existing.iter().chain(&self.added) {
+            if *existing_table == table && same(entry) {
+                if let Some(name) = entry.get("name").and_then(Value::as_str) {
+                    return name.to_owned();
+                }
+            }
+        }
+
+        let mut stem = behavior_stem(base);
+        // A stem in ZMK's reserved space (`macro_…`) stays reserved with any
+        // suffix, so move it out before counting.
+        if is_builtin(&format!("&{stem}")) {
+            stem.insert_str(0, "my_");
+        }
+        let mut name = format!("&{stem}");
+        let mut suffix = 2;
+        while self.taken.contains(&name) || is_builtin(&name) {
+            name = format!("&{stem}_{suffix}");
+            suffix += 1;
+        }
+        self.taken.insert(name.clone());
+        let mut entry = Map::new();
+        entry.insert("name".into(), json!(name));
+        entry.insert("description".into(), json!(""));
+        entry.extend(definition);
+        self.added.push((table, Value::Object(entry)));
+        name
+    }
+}
+
+/// Why a single action has no MoErgo binding, when that is known ahead of the
+/// keycode table: these are keys this firmware has and ZMK does not.
+fn refusal_for(action: Action) -> Option<Refusal> {
+    let why = match action {
+        // Bluetooth profiles and clears have `&bt` forms; the right half's
+        // bootloader key is `&bootloader` (the caller refuses a left-half one).
+        Action::User(0..=3 | 10..=12) => return None,
+        Action::User(13) => {
+            "USER(13) switches the link between the halves (Bluetooth or automatic); \
+             ZMK has no such key"
+        }
+        Action::User(id) => {
+            return Some(format!(
+                "USER({id}) is a key this firmware assigns at build time; MoErgo has no \
+                 equivalent"
+            ))
+        }
+        Action::Light(LightAction::BacklightToggle) => {
+            "BL_TOGG turns the key lighting output on and off; MoErgo's firmware has no \
+             backlight behavior (&bl)"
+        }
+        Action::Light(LightAction::BacklightUp | LightAction::BacklightDown) => {
+            "BL_UP/BL_DOWN change the key lighting output's brightness; MoErgo's firmware has no \
+             backlight behavior (&bl)"
+        }
+        Action::Light(
+            LightAction::BacklightOn
+            | LightAction::BacklightOff
+            | LightAction::BacklightStep
+            | LightAction::BacklightToggleBreathing,
+        ) => "this backlight key has no MoErgo equivalent; MoErgo's firmware has no &bl",
+        Action::Key(KeyCode::Hid(
+            HidKeyCode::MouseAccel0 | HidKeyCode::MouseAccel1 | HidKeyCode::MouseAccel2,
+        )) => "KC_ACL0-2 set the mouse-key speed; ZMK's mouse keys have no speed steps",
+        Action::DefaultLayer(layer) | Action::PersistentDefaultLayer(layer) => {
+            return Some(format!(
+                "DF({layer}) changes the default layer; ZMK has no such behavior"
+            ))
+        }
+        Action::KeyboardControl(KeyboardAction::MaintenanceModeToggle) => {
+            "MAINT_LOCK_TOG toggles this firmware's maintenance lock; ZMK has no such key"
+        }
+        _ => return None,
+    };
+    Some(why.to_owned())
+}
+
+/// The refusal for a `USER(12)` on the left half, which the keycode path
+/// cannot place because it only knows `&bootloader` on the right.
+pub(crate) fn left_half_bootloader() -> Refusal {
+    "USER(12) restarts the right half into its bootloader; on a left-half key MoErgo's \
+     &bootloader would restart the left half instead"
+        .to_owned()
+}
+
+fn is_autoshift(tap: Action, hold: Action) -> bool {
+    matches!(
+        (tap, hold),
+        (Action::Key(KeyCode::Hid(key)), Action::KeyWithModifier(shifted, modifiers))
+            if key == shifted && modifiers == ModifierCombination::LSHIFT
+    )
+}
+
+/// A morse whose patterns are 1..n taps and nothing else, as its actions in
+/// tap-count order.
+fn tap_sequence(morse: &Morse) -> Option<Vec<Action>> {
+    let count = morse.actions.len();
+    if count == 0 || count > 5 {
+        return None;
+    }
+    let mut pattern = TAP;
+    let mut actions = Vec::with_capacity(count);
+    for _ in 0..count {
+        actions.push(morse.get(pattern)?);
+        pattern = pattern.followed_by_tap();
+    }
+    Some(actions)
+}
+
+fn describe_patterns(morse: &Morse) -> String {
+    morse
+        .actions
+        .iter()
+        .map(|(pattern, action)| format!("{} {}", pattern_text(*pattern), action_text(*action)))
+        .collect::<Vec<_>>()
+        .join(", ")
+}
+
+/// A morse pattern in dots and dashes, `.` a tap and `-` a hold.
+fn pattern_text(pattern: MorsePattern) -> String {
+    let bits = pattern.to_u16();
+    let length = pattern.pattern_length();
+    (0..length)
+        .rev()
+        .map(|bit| if bits & (1 << bit) != 0 { '-' } else { '.' })
+        .collect()
+}
+
+fn plain_binding(action: KeyAction, cell: &Cell) -> Result<Value, Refusal> {
+    let code = crate::rynk_keycode::to_via_keycode(action);
+    if code == 0 && !matches!(action, KeyAction::No) {
+        return Err(format!("{action:?}"));
+    }
+    super::via_to_binding(code, cell.layer, cell.editor_index, cell.offset)
+        .map_err(|error| strip_location(&format!("{error:#}"), cell))
+}
+
+/// The keycode converter prefixes its errors with the cell; the caller adds
+/// its own, richer location.
+pub(crate) fn strip_location(message: &str, cell: &Cell) -> String {
+    let prefix = super::location(cell.layer, cell.editor_index, cell.offset);
+    message
+        .strip_prefix(&prefix)
+        .map(str::trim_start)
+        .unwrap_or(message)
+        .to_owned()
+}
+
+fn basic_name(key: HidKeyCode, what: &dyn Fn() -> String) -> Result<&'static str, Refusal> {
+    super::via_basic_to_zmk(key as u16).map_err(|error| format!("{}: {error}", what()))
+}
+
+fn is_modifier_key(key: HidKeyCode) -> bool {
+    (0xe0..=0xe7).contains(&(key as u16))
+}
+
+/// The ZMK name of a combination of exactly one modifier.
+fn single_modifier(modifiers: ModifierCombination) -> Option<String> {
+    let bits = modifiers.into_packed_bits();
+    (bits & 0x0f)
+        .is_power_of_two()
+        .then(|| super::modifier_bits_to_zmk(bits).ok())?
+}
+
+fn flavor_of(mode: MorseMode) -> &'static str {
+    match mode {
+        MorseMode::Normal => "tap-preferred",
+        MorseMode::HoldOnOtherPress => "hold-preferred",
+        MorseMode::PermissiveHold => "balanced",
+        MorseMode::TapUnlessInterrupted => "tap-unless-interrupted",
+    }
+}
+
+fn action_text(action: Action) -> String {
+    let code = crate::rynk_keycode::to_via_keycode(KeyAction::Single(action));
+    if code == 0 && action != Action::No {
+        format!("{action:?}")
+    } else {
+        crate::keycodes::format_keycode(code)
+    }
+}
+
+fn macro_op_text(op: &MacroOp) -> &'static str {
+    match op {
+        MacroOp::Delay(_) => "delay",
+        MacroOp::Char(_) => "text",
+        MacroOp::PauseForRelease => "pause-for-release",
+        _ => "key",
+    }
+}
+
+/// A behavior name stem: ZMK names are letters, digits and underscores,
+/// starting with a letter, and the editor caps them at 65 characters.
+fn behavior_stem(base: &str) -> String {
+    let mut stem: String = base
+        .trim_start_matches('&')
+        .chars()
+        .map(|character| {
+            if character.is_ascii_alphanumeric() {
+                character
+            } else {
+                '_'
+            }
+        })
+        .collect();
+    if !stem.starts_with(|character: char| character.is_ascii_alphabetic()) {
+        stem.insert_str(0, "b_");
+    }
+    // Leave room for the `&` and a `_NN` suffix.
+    stem.truncate(60);
+    stem
+}
+
+fn is_builtin(name: &str) -> bool {
+    const BUILTINS: &[&str] = &[
+        "&bl",
+        "&bootloader",
+        "&bt",
+        "&bt_0",
+        "&bt_1",
+        "&bt_2",
+        "&bt_3",
+        "&caps_word",
+        "&ext_power",
+        "&gresc",
+        "&key_repeat",
+        "&kp",
+        "&kt",
+        "&layer",
+        "&lower",
+        "&lt",
+        "&magic",
+        "&mkp",
+        "&mmv",
+        "&mo",
+        "&msc",
+        "&mt",
+        "&none",
+        "&out",
+        "&reset",
+        "&rgb_ug",
+        "&sk",
+        "&sl",
+        "&soft_off",
+        "&sys_reset",
+        "&to",
+        "&tog",
+        "&trans",
+    ];
+    BUILTINS.contains(&name) || name.starts_with("&macro_")
+}
+
+/// The mod-morph `mods` a fork's condition reads as, or why it has none.
+fn fork_condition(fork: &Fork) -> Result<Vec<&'static str>, Refusal> {
+    if fork.negative_output != fork.trigger {
+        return Err("it replaces the key's own output even without its modifiers".into());
+    }
+    if fork.match_none != StateBits::default() {
+        return Err("it is suppressed by some modifiers, which a mod-morph cannot say".into());
+    }
+    if fork.layers != u32::MAX {
+        return Err("it applies on some layers only, which a mod-morph cannot say".into());
+    }
+    let only_modifiers = StateBits {
+        modifiers: fork.match_any.modifiers,
+        ..StateBits::default()
+    };
+    if fork.match_any != only_modifiers {
+        return Err("it also matches lock or mouse-button state, which a mod-morph cannot".into());
+    }
+    let mods = modifier_names(fork.match_any.modifiers);
+    if mods.is_empty() {
+        return Err("it matches no modifier".into());
+    }
+    Ok(mods)
+}
+
+/// ZMK's `MOD_*` names for a modifier combination.
+fn modifier_names(modifiers: ModifierCombination) -> Vec<&'static str> {
+    [
+        (modifiers.left_ctrl(), "MOD_LCTL"),
+        (modifiers.left_shift(), "MOD_LSFT"),
+        (modifiers.left_alt(), "MOD_LALT"),
+        (modifiers.left_gui(), "MOD_LGUI"),
+        (modifiers.right_ctrl(), "MOD_RCTL"),
+        (modifiers.right_shift(), "MOD_RSFT"),
+        (modifiers.right_alt(), "MOD_RALT"),
+        (modifiers.right_gui(), "MOD_RGUI"),
+    ]
+    .into_iter()
+    .filter_map(|(set, name)| set.then_some(name))
+    .collect()
+}
+
+fn modifier_key_name(modifier: ModifierKey) -> &'static str {
+    match modifier {
+        ModifierKey::LCtrl => "LCTRL",
+        ModifierKey::LShift => "LSHFT",
+        ModifierKey::LAlt => "LALT",
+        ModifierKey::LGui => "LGUI",
+        ModifierKey::RCtrl => "RCTRL",
+        ModifierKey::RShift => "RSHFT",
+        ModifierKey::RAlt => "RALT",
+        ModifierKey::RGui => "RGUI",
+    }
+}
+
+/// A key as the keymap spells it, for messages.
+fn action_label(action: KeyAction) -> String {
+    let code = crate::rynk_keycode::to_via_keycode(action);
+    if code == 0 && !matches!(action, KeyAction::No) {
+        format!("{action:?}")
+    } else {
+        crate::keycodes::format_keycode(code)
+    }
+}
+
+/// A combo name: ZMK node names are a letter, then letters, digits and
+/// underscores, without the `&` behaviors carry.
+fn combo_name(label: &str, index: usize) -> String {
+    let stem = behavior_stem(label);
+    if stem.len() < 2 {
+        format!("combo_{index}")
+    } else {
+        stem
+    }
+}
+
+/// Removes the template's definitions that its own keymap used and the new
+/// keymap no longer does: the export replaced them, and left behind they
+/// would be read again on the next import (a home-row-mod hold-tap still
+/// naming its finger layer would make the import drop a layer that is now
+/// something else). Definitions the template never used are kept.
+pub(crate) fn prune_superseded(before: &Map<String, Value>, after: &mut Map<String, Value>) {
+    let used_before = reachable(before);
+    let used_after = reachable(after);
+    for table in Table::ALL {
+        let Some(entries) = after.get_mut(table.key()).and_then(Value::as_array_mut) else {
+            continue;
+        };
+        entries.retain(|entry| {
+            let Some(name) = entry.get("name").and_then(Value::as_str) else {
+                return true;
+            };
+            !(used_before.contains(name) && !used_after.contains(name))
+        });
+    }
+}
+
+/// Every behavior name a document's keymap, combos and input listeners reach,
+/// directly or through other definitions.
+fn reachable(layout: &Map<String, Value>) -> BTreeSet<String> {
+    let mut definitions: Vec<(String, Value)> = Vec::new();
+    for table in Table::ALL {
+        for entry in layout
+            .get(table.key())
+            .and_then(Value::as_array)
+            .into_iter()
+            .flatten()
+        {
+            if let Some(name) = entry.get("name").and_then(Value::as_str) {
+                let mut body = entry.clone();
+                if let Some(object) = body.as_object_mut() {
+                    object.remove("name");
+                    object.remove("description");
+                }
+                definitions.push((name.to_owned(), body));
+            }
+        }
+    }
+    let mut seen = BTreeSet::new();
+    for root in ["layers", "combos", "inputListeners"] {
+        if let Some(value) = layout.get(root) {
+            behavior_names(value, &mut seen);
+        }
+    }
+    loop {
+        let before = seen.len();
+        for (name, body) in &definitions {
+            if seen.contains(name) {
+                behavior_names(body, &mut seen);
+            }
+        }
+        if seen.len() == before {
+            return seen;
+        }
+    }
+}
+
+fn behavior_names(value: &Value, out: &mut BTreeSet<String>) {
+    match value {
+        Value::String(text) if text.starts_with('&') => {
+            // A `Custom` binding is raw devicetree text; its behavior is the
+            // first word.
+            out.insert(text.split_whitespace().next().unwrap_or(text).to_owned());
+        }
+        Value::Array(items) => items.iter().for_each(|item| behavior_names(item, out)),
+        Value::Object(object) => object.values().for_each(|item| behavior_names(item, out)),
+        _ => {}
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn trigger_positions_are_the_other_hand_and_own_thumbs() {
+        let left = Hand::Left.trigger_positions();
+        // TailorKey's left-hand home-row mods list exactly these 46 keys.
+        assert_eq!(left.len(), 46);
+        for thumb in LEFT_THUMBS.iter().chain(&RIGHT_THUMBS) {
+            assert!(left.contains(thumb), "{thumb}");
+        }
+        assert!(!left.contains(&35), "left pinky home key");
+        assert!(left.contains(&44), "right pinky home key");
+        let right = Hand::Right.trigger_positions();
+        assert!(right.contains(&35) && !right.contains(&44));
+    }
+
+    #[test]
+    fn pattern_text_spells_taps_and_holds() {
+        assert_eq!(pattern_text(TAP), ".");
+        assert_eq!(pattern_text(HOLD), "-");
+        assert_eq!(pattern_text(TAP.followed_by_tap()), "..");
+    }
+
+    #[test]
+    fn stems_are_valid_zmk_names() {
+        assert_eq!(behavior_stem("shiftdance_v1_TK"), "shiftdance_v1_TK");
+        assert_eq!(behavior_stem("F4 double"), "F4_double");
+        assert_eq!(behavior_stem("4ward"), "b_4ward");
+    }
+}
