@@ -0,0 +1,399 @@
+//! Export to the MoErgo Layout Editor's JSON, checked by reading it back.
+//!
+//! An export is right when the import reads it as the same keyboard. For a
+//! layout that came from the editor that means the same snapshot, exactly;
+//! for TailorKey for RMK, written as TOML, it means every key does the same
+//! thing (a profiled tap-hold comes back as a morse with that profile, which
+//! is the same key under another runtime spelling).
+
+use moergo_config::{
+    import_moergo_layout, snapshot_to_moergo_json, RuntimeConfig, Severity, Snapshot,
+};
+use rynk::rmk_types::action::{Action, KeyAction, KeyboardAction, LightAction};
+use rynk::rmk_types::combo::ComboDefinition;
+use rynk::rmk_types::keyboard_macros::MacroOp;
+use rynk::rmk_types::keycode::{HidKeyCode, KeyCode};
+use rynk::rmk_types::morse::{MorseMode, MorseProfile, HOLD, TAP};
+use serde_json::{json, Value};
+
+/// TailorKey v5.2 Bilateral as the editor exports it: home-row mods built from
+/// hold-taps, finger layers and macros. This is the GLIDE layout case.
+const TAILORKEY_JSON: &str = include_str!("fixtures/tailorkey-v52-bilateral.json");
+/// sunaku's Glorious Engrammer: mod-morphs, sticky keys, layer-taps.
+const ENGRAMMER_JSON: &str = include_str!("fixtures/engrammer-v52a-no-code.json");
+/// TailorKey for RMK, the TOML GLIDE4RMK ships as its golden layout.
+const TAILORKEY_TOML: &str = include_str!("fixtures/glove80-tailorkey-qwerty.toml");
+
+fn import(text: &str) -> (RuntimeConfig, Snapshot) {
+    let imported = import_moergo_layout(text).expect("import");
+    let dropped: Vec<_> = imported
+        .diagnostics
+        .iter()
+        .filter(|diagnostic| diagnostic.severity == Severity::Dropped)
+        .collect();
+    assert!(dropped.is_empty(), "import dropped bindings: {dropped:#?}");
+    let snapshot = imported.runtime.snapshot().expect("snapshot");
+    (imported.runtime, snapshot)
+}
+
+fn document(text: &str) -> Value {
+    serde_json::from_str(text).unwrap()
+}
+
+/// Import, export and import again, with and without the original file as the
+/// template, and require the same snapshot every time.
+fn assert_editor_layout_round_trips(original: &str) {
+    let (labels, first) = import(original);
+    for template in [None, Some(original)] {
+        let exported = snapshot_to_moergo_json(&first, Some(&labels), template)
+            .unwrap_or_else(|error| panic!("export (template: {}): {error:#}", template.is_some()));
+        let (relabels, second) = import(&exported);
+        assert_eq!(first, second, "template: {}", template.is_some());
+
+        // Writing the same keyboard over its own export changes nothing: every
+        // definition it needs is already there and is reused, not repeated.
+        let again = snapshot_to_moergo_json(&second, Some(&relabels), Some(&exported)).unwrap();
+        assert_eq!(exported, again, "template: {}", template.is_some());
+    }
+}
+
+#[test]
+fn glide_layout_with_home_row_mods_round_trips() {
+    assert_editor_layout_round_trips(TAILORKEY_JSON);
+}
+
+#[test]
+fn engrammer_with_mod_morphs_and_sticky_keys_round_trips() {
+    assert_editor_layout_round_trips(ENGRAMMER_JSON);
+}
+
+#[test]
+fn home_row_mods_export_as_bilateral_hold_taps() {
+    let (labels, snapshot) = import(TAILORKEY_JSON);
+    let exported = document(&snapshot_to_moergo_json(&snapshot, Some(&labels), None).unwrap());
+    let hold_taps = exported["holdTaps"].as_array().unwrap();
+    let left = hold_taps
+        .iter()
+        .find(|entry| entry["name"].as_str().unwrap().ends_with("_left"))
+        .expect("a left-hand home-row mod");
+    assert_eq!(left["bindings"], json!(["&kp", "&kp"]));
+    let positions = left["holdTriggerKeyPositions"].as_array().unwrap();
+    assert_eq!(
+        positions.len(),
+        46,
+        "the right hand and both thumb clusters"
+    );
+    assert!(
+        !positions.contains(&json!(35)),
+        "not the left pinky's own home key"
+    );
+    // The left pinky home key names it, with its modifier and its letter.
+    let pinky = &exported["layers"][0][35];
+    assert!(pinky["value"].as_str().unwrap().starts_with('&'));
+    assert_eq!(pinky["params"].as_array().unwrap().len(), 2);
+    // No two definitions of one table say the same thing.
+    for table in ["holdTaps", "macros", "tapDances", "stickyKeys", "modMorphs"] {
+        let mut bodies: Vec<String> = exported[table]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .map(|entry| {
+                let mut entry = entry.clone();
+                entry.as_object_mut().unwrap().remove("name");
+                entry.to_string()
+            })
+            .collect();
+        let count = bodies.len();
+        bodies.sort();
+        bodies.dedup();
+        assert_eq!(bodies.len(), count, "{table} repeats a definition");
+    }
+}
+
+#[test]
+fn template_keeps_unused_definitions_and_drops_the_ones_the_export_replaced() {
+    let (labels, snapshot) = import(TAILORKEY_JSON);
+    let mut template = document(TAILORKEY_JSON);
+    template["holdTaps"].as_array_mut().unwrap().push(json!({
+        "name": "&kept_for_later",
+        "description": "not on any key",
+        "tappingTermMs": 200,
+        "bindings": ["&kp", "&kp"]
+    }));
+    let exported = document(
+        &snapshot_to_moergo_json(&snapshot, Some(&labels), Some(&template.to_string())).unwrap(),
+    );
+    let names: Vec<&str> = exported["holdTaps"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|entry| entry["name"].as_str().unwrap())
+        .collect();
+    assert!(names.contains(&"&kept_for_later"));
+    // The finger-layer home-row mods named layers the import dropped; left in
+    // the file they would make the next import drop real layers.
+    assert!(!names.contains(&"&HRM_left_pinky_v1B_TKZ"), "{names:?}");
+    assert_eq!(
+        exported["title"], template["title"],
+        "document identity is kept"
+    );
+}
+
+/// What a key does, independent of how the runtime spells it.
+#[derive(Debug, PartialEq)]
+enum Meaning {
+    Key(KeyAction),
+    Pattern(Vec<(u16, Action)>, Timing),
+    Macro(Vec<MacroOp>),
+}
+
+/// The timing a MoErgo hold-tap or tap-dance can carry, with fields the
+/// profile leaves open read from the source's default profile.
+#[derive(Debug, PartialEq)]
+struct Timing {
+    mode: Option<MorseMode>,
+    hold_ms: Option<u16>,
+    gap_ms: Option<u16>,
+    quick_tap_ms: Option<u16>,
+    prior_idle_ms: Option<u16>,
+    unilateral: bool,
+}
+
+fn timing(profile: MorseProfile, default: MorseProfile, taps_only: bool) -> Timing {
+    Timing {
+        mode: (!taps_only).then(|| profile.mode()).flatten(),
+        hold_ms: (!taps_only)
+            .then(|| profile.hold_timeout_ms().or(default.hold_timeout_ms()))
+            .flatten(),
+        gap_ms: taps_only
+            .then(|| profile.gap_timeout_ms().or(default.gap_timeout_ms()))
+            .flatten(),
+        quick_tap_ms: (!taps_only)
+            .then(|| profile.quick_tap_timeout_ms())
+            .flatten(),
+        prior_idle_ms: (!taps_only).then(|| profile.prior_idle_time_ms()).flatten(),
+        unilateral: profile.unilateral_tap() == Some(true),
+    }
+}
+
+fn meaning(snapshot: &Snapshot, default: MorseProfile, action: KeyAction) -> Meaning {
+    let behaviors = &snapshot.behaviors;
+    match action {
+        KeyAction::Morse(index) => {
+            let morse = &behaviors.morses.as_ref().unwrap()[usize::from(index)];
+            let actions: Vec<(u16, Action)> = morse
+                .actions
+                .iter()
+                .map(|(pattern, action)| (pattern.to_u16(), *action))
+                .collect();
+            if actions.len() == 1 {
+                return Meaning::Key(KeyAction::Single(actions[0].1));
+            }
+            let taps_only = morse.get(HOLD).is_none();
+            let mut sorted = actions;
+            sorted.sort_by_key(|(pattern, _)| *pattern);
+            Meaning::Pattern(sorted, timing(morse.profile, default, taps_only))
+        }
+        KeyAction::TapHold(tap, hold, index) => {
+            let profile = behaviors
+                .morse_profiles
+                .as_deref()
+                .unwrap_or_default()
+                .iter()
+                .find(|entry| entry.index == index)
+                .map(|entry| entry.profile);
+            match profile {
+                Some(profile) => Meaning::Pattern(
+                    vec![(TAP.to_u16(), tap), (HOLD.to_u16(), hold)],
+                    timing(profile, default, false),
+                ),
+                None => Meaning::Key(action),
+            }
+        }
+        KeyAction::Single(Action::TriggerMacro(index)) => {
+            Meaning::Macro(behaviors.macros.as_ref().unwrap()[usize::from(index)].clone())
+        }
+        other => Meaning::Key(other),
+    }
+}
+
+/// A combo's keys (row, column), its layer, and what it sends.
+type ComboMeaning = (Vec<(u8, u8)>, Option<u8>, Meaning);
+
+/// Keys and chords TailorKey for RMK has that ZMK has not.
+fn has_no_zmk_equivalent(action: KeyAction) -> bool {
+    matches!(
+        action,
+        KeyAction::Single(
+            Action::Light(
+                LightAction::BacklightUp
+                    | LightAction::BacklightDown
+                    | LightAction::BacklightToggle
+            ) | Action::Key(KeyCode::Hid(
+                HidKeyCode::MouseAccel0 | HidKeyCode::MouseAccel1 | HidKeyCode::MouseAccel2
+            )) | Action::KeyboardControl(KeyboardAction::MaintenanceModeToggle)
+        )
+    )
+}
+
+#[test]
+fn tailorkey_toml_names_every_key_moergo_cannot_hold() {
+    let config = RuntimeConfig::from_toml(TAILORKEY_TOML).unwrap();
+    let error = snapshot_to_moergo_json(&config.snapshot().unwrap(), Some(&config), None)
+        .unwrap_err()
+        .to_string();
+    assert!(
+        error.starts_with("13 bindings cannot be written as MoErgo JSON"),
+        "{error}"
+    );
+    for expected in [
+        "layer 6 (Mouse), editor key 41 (r3,c9): KC_ACL0-2",
+        "layer 8 (Magic), editor key 27 (r2,c5): BL_TOGG",
+        "combo 'combo 14': MAINT_LOCK_TOG",
+    ] {
+        assert!(error.contains(expected), "missing {expected:?} in {error}");
+    }
+    // The keys the issue was about are not among them.
+    assert!(!error.contains("TD("), "{error}");
+    assert!(!error.contains("USER("), "{error}");
+    assert!(!error.contains("MACRO("), "{error}");
+}
+
+#[test]
+fn tailorkey_toml_round_trips_through_moergo_json() {
+    let config = RuntimeConfig::from_toml(TAILORKEY_TOML).unwrap();
+    let mut source = config.snapshot().unwrap();
+    // Take out what ZMK cannot say (the test above names it); the rest of the
+    // layout has to come back doing the same thing.
+    for layer in &mut source.layers {
+        for action in layer.iter_mut() {
+            if has_no_zmk_equivalent(*action) {
+                *action = KeyAction::No;
+            }
+        }
+    }
+    let mut labels = config.clone();
+    if let Some(combos) = source.behaviors.combos.as_mut() {
+        let keep: Vec<bool> = combos
+            .iter()
+            .map(|combo| match combo {
+                ComboDefinition::Positions(combo) => !has_no_zmk_equivalent(combo.output),
+                ComboDefinition::Actions(_) => true,
+            })
+            .collect();
+        let mut flags = keep.iter();
+        combos.retain(|_| *flags.next().unwrap());
+        let mut flags = keep.iter();
+        labels.combos.retain(|_| *flags.next().unwrap());
+    }
+
+    let exported = snapshot_to_moergo_json(&source, Some(&labels), None).expect("export");
+    let (relabels, back) = import(&exported);
+
+    let default = source
+        .behaviors
+        .config
+        .as_ref()
+        .map(|config| config.morse_default_profile)
+        .unwrap();
+    assert_eq!(source.layers.len(), back.layers.len());
+    for (layer, (before, after)) in source.layers.iter().zip(&back.layers).enumerate() {
+        for (offset, (a, b)) in before.iter().zip(after).enumerate() {
+            assert_eq!(
+                meaning(&source, default, *a),
+                meaning(&back, default, *b),
+                "layer {layer} offset {offset}: {a:?} became {b:?}"
+            );
+        }
+    }
+
+    let combos = |snapshot: &Snapshot| -> Vec<ComboMeaning> {
+        snapshot
+            .behaviors
+            .combos
+            .as_deref()
+            .unwrap_or_default()
+            .iter()
+            .map(|combo| match combo {
+                ComboDefinition::Positions(combo) => (
+                    combo.positions.iter().map(|p| (p.row, p.col)).collect(),
+                    combo.layer,
+                    meaning(snapshot, default, combo.output),
+                ),
+                ComboDefinition::Actions(_) => panic!("TailorKey combos are positional"),
+            })
+            .collect()
+    };
+    assert_eq!(combos(&source), combos(&back));
+
+    // TailorKey's one fork turns its shift tap-dance into Caps Lock.
+    let forks = |snapshot: &Snapshot| -> Vec<(Meaning, Meaning)> {
+        snapshot
+            .behaviors
+            .forks
+            .as_deref()
+            .unwrap_or_default()
+            .iter()
+            .map(|fork| {
+                (
+                    meaning(snapshot, default, fork.trigger),
+                    meaning(snapshot, default, fork.positive_output),
+                )
+            })
+            .collect()
+    };
+    assert_eq!(forks(&source), forks(&back));
+    assert_eq!(forks(&back).len(), 1);
+
+    // And the export is a fixed point from there on.
+    let again = snapshot_to_moergo_json(&back, Some(&relabels), Some(&exported)).unwrap();
+    assert_eq!(exported, again);
+}
+
+fn with_cell(action: KeyAction, row: usize, col: usize) -> Result<String, String> {
+    let (labels, mut snapshot) = import(TAILORKEY_JSON);
+    snapshot.layers[0][row * 14 + col] = action;
+    snapshot_to_moergo_json(&snapshot, Some(&labels), None).map_err(|error| error.to_string())
+}
+
+#[test]
+fn user_keys_map_to_moergo_or_say_why_not() {
+    let user = |id| KeyAction::Single(Action::User(id));
+    // Bluetooth profile and clear keys have `&bt` forms anywhere.
+    for (id, binding) in [
+        (0, json!({ "value": "&bt_0" })),
+        (3, json!({ "value": "&bt_3" })),
+        (
+            10,
+            json!({ "value": "&bt", "params": [{ "value": "BT_CLR", "params": [] }] }),
+        ),
+        (
+            11,
+            json!({ "value": "&bt", "params": [{ "value": "BT_CLR_ALL", "params": [] }] }),
+        ),
+    ] {
+        let exported = document(&with_cell(user(id), 3, 2).unwrap());
+        // r3,c2 is editor key 36.
+        assert_eq!(exported["layers"][0][36], binding, "USER({id})");
+    }
+    // The right half's bootloader key is `&bootloader`; on the left it would
+    // restart the wrong half.
+    let exported = document(&with_cell(user(12), 3, 11).unwrap());
+    assert_eq!(exported["layers"][0][43], json!({ "value": "&bootloader" }));
+    let error = with_cell(user(12), 3, 2).unwrap_err();
+    assert!(
+        error.contains("editor key 36 (r3,c2): USER(12) restarts the right half"),
+        "{error}"
+    );
+    // The split-transport toggle (the simulated Glove80's Magic layer has it).
+    let error = with_cell(user(13), 3, 2).unwrap_err();
+    assert!(
+        error.contains("USER(13) switches the link between the halves"),
+        "{error}"
+    );
+    let error = with_cell(user(20), 3, 2).unwrap_err();
+    assert!(
+        error.contains("USER(20) is a key this firmware assigns"),
+        "{error}"
+    );
+}
