+//! The Go60's MoErgo JSON: MoErgo's factory default layout read, written and
+//! read again.
+
+use moergo_config::{import_moergo_layout, snapshot_to_moergo_json, Severity, GO60_TO_MATRIX};
+use rynk::rmk_types::action::{Action, KeyAction};
+use rynk::rmk_types::keycode::{HidKeyCode, KeyCode};
+use serde_json::{json, Value};
+
+/// MoErgo's Go60 factory default: four layers, `&layer` keys, a mod-tap
+/// thumb, the Magic layer's Bluetooth and RGB keys, and both trackpads.
+const FACTORY: &str = include_str!("fixtures/go60-factory-default.json");
+const GLOVE80: &str = include_str!("fixtures/tailorkey-v52-bilateral.json");
+
+fn cell(row: usize, col: usize) -> usize {
+    row * 14 + col
+}
+
+#[test]
+fn the_factory_layout_reads_as_a_go60() {
+    let imported = import_moergo_layout(FACTORY).expect("import");
+    let dropped: Vec<_> = imported
+        .diagnostics
+        .iter()
+        .filter(|diagnostic| diagnostic.severity == Severity::Dropped)
+        .collect();
+    assert!(dropped.is_empty(), "{dropped:#?}");
+    let snapshot = imported.runtime.snapshot().unwrap();
+    assert_eq!((snapshot.rows, snapshot.cols), (5, 14));
+    assert_eq!(snapshot.layers.len(), 4);
+    let base = &snapshot.layers[0];
+    let key = |code| KeyAction::Single(Action::Key(KeyCode::Hid(code)));
+    // Editor key 25 is the left pinky home key, A; 30 is the right inner home key, H.
+    assert_eq!(base[cell(2, 1)], key(HidKeyCode::A));
+    assert_eq!(base[cell(2, 8)], key(HidKeyCode::H));
+    // The fifth row: GRAVE DEL BSPC | LGUI [ ].
+    assert_eq!(base[cell(4, 2)], key(HidKeyCode::Grave));
+    assert_eq!(base[cell(4, 11)], key(HidKeyCode::RightBracket));
+    // Thumbs: LH T1 holds SymbolNav, RH T2 is space, RH T1 taps Enter.
+    assert_eq!(base[GO60_TO_MATRIX[54]], base[cell(0, 6)]);
+    assert_eq!(base[cell(1, 7)], key(HidKeyCode::Space));
+    assert!(
+        matches!(base[cell(0, 7)], KeyAction::TapHold(..)),
+        "{:?}",
+        base[cell(0, 7)]
+    );
+    // The Keypad layer's &to 0 sits on RH C6R4.
+    assert_eq!(
+        snapshot.layers[1][cell(3, 13)],
+        KeyAction::Single(Action::LayerToggleOnly(0))
+    );
+}
+
+#[test]
+fn the_factory_layout_round_trips() {
+    let imported = import_moergo_layout(FACTORY).unwrap();
+    let first = imported.runtime.snapshot().unwrap();
+    for template in [None, Some(FACTORY)] {
+        let exported = snapshot_to_moergo_json(&first, Some(&imported.runtime), template)
+            .unwrap_or_else(|error| panic!("export: {error:#}"));
+        let document: Value = serde_json::from_str(&exported).unwrap();
+        assert_eq!(document["keyboard"], "go60");
+        for layer in document["layers"].as_array().unwrap() {
+            assert_eq!(layer.as_array().unwrap().len(), 60);
+        }
+        let back = import_moergo_layout(&exported).unwrap();
+        let second = back.runtime.snapshot().unwrap();
+        assert_eq!(first, second, "template: {}", template.is_some());
+        let again = snapshot_to_moergo_json(&second, Some(&back.runtime), Some(&exported)).unwrap();
+        assert_eq!(exported, again);
+    }
+    // The template keeps what the keymap does not hold: the trackpads.
+    let exported: Value = serde_json::from_str(
+        &snapshot_to_moergo_json(&first, Some(&imported.runtime), Some(FACTORY)).unwrap(),
+    )
+    .unwrap();
+    let original: Value = serde_json::from_str(FACTORY).unwrap();
+    assert_eq!(exported["inputListeners"], original["inputListeners"]);
+    assert_eq!(exported["notes"], original["notes"]);
+}
+
+#[test]
+fn trackpad_slots_after_the_keys_are_read_past() {
+    let mut document: Value = serde_json::from_str(FACTORY).unwrap();
+    for layer in document["layers"].as_array_mut().unwrap() {
+        let keys = layer.as_array_mut().unwrap();
+        keys.push(json!({ "value": "&none" }));
+        keys.push(json!({ "value": "&trans" }));
+    }
+    let wide = import_moergo_layout(&document.to_string()).unwrap();
+    let plain = import_moergo_layout(FACTORY).unwrap();
+    assert_eq!(
+        wide.runtime.snapshot().unwrap(),
+        plain.runtime.snapshot().unwrap()
+    );
+}
