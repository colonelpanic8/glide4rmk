uid = "moergo_magic_layer"

runs_on = "glide4rmk"

title = "MoErgo Magic layer"

subtitle = "MoErgo's Magic layer, or only its status lights"

description = '''
Sets up the Magic layer of your Glove80 or Go60 as MoErgo's firmware has it, or adds only its status lights. It works on the layer named Magic; a layout without one gets a new layer named Magic, held down by the lower-left key of your base layer when that key is free.

- **The Magic layer:** MoErgo's keys on it: one for each Bluetooth profile the keyboard has (four on a Glove80, three on a Go60) and USB, the RGB controls, Bootloader and Reboot, and the keys that forget pairings. Your other keys on the layer stay. Its earlier lights go, and the left half is dark around the status lights.
- **Only the status lights:** your keys and your other lights stay.
- **The lights, while you hold it:** which layers are on, Caps, Num and Scroll Lock, each half's battery, each Bluetooth profile and USB, and the maintenance lock on Z (green while the keyboard can be changed, red while locked).
- The layer wakes the lights while they are off. Running it again puts back what it made.'''

category = "Looks & lighting"

script = '''
# ==============================================================================
# MoErgo Magic layer
#
# Where the keys and lights go is each board's own table in GLIDE4RMK's board
# registry (model/boards/magic-layer.ts). set_magic_layer finds the layer named
# Magic, or the one MoErgo's key holds down, or adds one, and writes it: no
# layer number is assumed. This script passes the choice on and says what
# happened.
#
# Changed: the Magic layer's status lights and the wake layers; with its keys
# also MoErgo's keys on it and its scene, its own earlier lights cleared first.
# Not changed: your other keys on it, other layers, combos, behaviors.
# ==============================================================================

($what == "layer") as $keys |

if $view.board.magic_layer | not then
  error("Only the Glove80 and the Go60 have MoErgo's Magic layer, so nothing was changed.")
else
  ((first($view.layers[] | select(.name | ascii_downcase | gsub("^\\s+|\\s+$"; "") == "magic")) | .name) // "The Magic layer") as $name |
  {
    operations: [{name: "set_magic_layer", input: {keys: $keys}}],
    report: {
      message: (if $keys then "\($name) is the \($view.board.name)'s Magic layer, with its status lights." else "\($name) has the \($view.board.name)'s status lights; its keys are as they were." end),
      lines: ((if $keys then [{text: "Bluetooth profile, USB, RGB, Bootloader and Reboot keys; your other keys stay", ok: true}] else [] end) + [
        {text: "Layers, locks, batteries and connections light while it is held", ok: true},
        {text: "Maintenance lock on Z", ok: true},
        {text: "Wakes the lights", ok: true}
      ]),
      log: ["board \($view.board.id)", "keys \($keys)"]
    }
  }
end
'''

[manifest]
author = "moosyresearch"
icon = "🪄"
keywords = ["magic", "status", "battery", "bluetooth", "usb", "rgb", "lighting", "moergo", "factory"]
keyboards = ["glove80", "go60"]
requires = ["lighting.rules", "lighting.rules.connection", "lighting.rules.indicators", "lighting.rules.device", "lighting.output"]

[[param]]
id = "what"
label = "Change"
type = "select"
options = ["layer", "lights"]
labels = ["The Magic layer: MoErgo's keys and its lights", "Only the status lights"]
default = "layer"
